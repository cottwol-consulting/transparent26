#!/bin/bash
mkdir -p /opt/osdp-conformance/log
echo >>/opt/osdp-conformance/log/actions.log osdp_XRD called $1 $2 $3 $4 $5 $6 $7 $8
# note we stay in the directory open-osdp was started in.
/opt/transparent26/bin/osdp-action-xread 2>>/opt/osdp-conformance/log/t26_stderr.log \
  $1 $2 $3 $4 $5 $6 $7 $8

